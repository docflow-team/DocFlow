# Copy to .env and set your own local password. These values are examples, not real secrets.
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=docflow
POSTGRES_PORT=5432
API_PORT=8080

# Private local object storage. Choose a password of at least 8 characters.
MINIO_ROOT_USER=docflow
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=docflow-documents
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# One-off admin bootstrap reads DOCFLOW_BOOTSTRAP_USERNAME, DOCFLOW_BOOTSTRAP_EMAIL
# and DOCFLOW_BOOTSTRAP_PASSWORD from your shell. See README; no defaults are shipped.

# Generate a random signing secret (see README); no default is supplied.
DOCFLOW_JWT_SECRET=
