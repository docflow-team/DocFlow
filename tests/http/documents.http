@baseUrl = http://localhost:8080
@documentId = 1
@categoryId = 1
@accessToken = paste-your-current-token

### Upload PDF; captures no background work (202, NOT_STARTED)
POST {{baseUrl}}/api/v1/documents
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=DocFlowBoundary

--DocFlowBoundary
Content-Disposition: form-data; name="title"

Sample invoice
--DocFlowBoundary
Content-Disposition: form-data; name="file"; filename="sample.pdf"
Content-Type: application/pdf

< ../fixtures/sample.pdf
--DocFlowBoundary--

### List own PDFs
GET {{baseUrl}}/api/v1/documents?page=0&size=20
Authorization: Bearer {{accessToken}}

### Read metadata
GET {{baseUrl}}/api/v1/documents/{{documentId}}
Authorization: Bearer {{accessToken}}

### Replace editable metadata; null clears description
PUT {{baseUrl}}/api/v1/documents/{{documentId}}/metadata
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title":"Renamed invoice","description":null}

### List categories; choose IDs from this response
GET {{baseUrl}}/api/v1/categories
Authorization: Bearer {{accessToken}}

### Replace all category assignments; [] clears them
PUT {{baseUrl}}/api/v1/documents/{{documentId}}/categories
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"categoryIds":[{{categoryId}}]}

### Replace tags; names are trimmed/lowercased and deduplicated; [] clears them
PUT {{baseUrl}}/api/v1/documents/{{documentId}}/tags
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"tags":[" Housing ","housing","Study"]}

### Download PDF
GET {{baseUrl}}/api/v1/documents/{{documentId}}/content
Authorization: Bearer {{accessToken}}
Accept: application/pdf

### Read inactive processing status
GET {{baseUrl}}/api/v1/documents/{{documentId}}/processing
Authorization: Bearer {{accessToken}}

### Delete PDF and metadata
DELETE {{baseUrl}}/api/v1/documents/{{documentId}}
Authorization: Bearer {{accessToken}}
